<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="90"
                android:startColor="@color/ember_orange_dim"
                android:endColor="@color/arcane_violet" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="90"
                android:startColor="@color/ember_orange"
                android:endColor="@color/arcane_violet" />
        </shape>
    </item>
</selector>
