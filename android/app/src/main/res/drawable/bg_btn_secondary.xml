<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/panel_indigo_light" />
            <stroke android:width="1.5dp" android:color="@color/gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/panel_indigo" />
            <stroke android:width="1.5dp" android:color="@color/loom_teal" />
        </shape>
    </item>
</selector>
